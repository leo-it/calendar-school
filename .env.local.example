# Variables de entorno para desarrollo local
# Copia este archivo a .env.local y completa los valores reales
# 
# IMPORTANTE: .env.local está en .gitignore y NO se sube al repositorio
# Este archivo (.env.local.example) SÍ se sube como referencia

# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres@localhost:5432/almanaque?schema=public

# NextAuth
NEXTAUTH_URL=http://localhost:7000
NEXTAUTH_SECRET=genera-un-secret-seguro-con-openssl-rand-base64-32

# Node environment
NODE_ENV=development

# Groq API Key (para el chatbot)
# Obtén una gratis en: https://console.groq.com
GROQ_API_KEY=tu_api_key_aqui

# Opcionales para notificaciones
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# WHATSAPP_API_KEY=your-whatsapp-api-key
